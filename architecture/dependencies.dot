    "actor.script" [shape=ellipse, style="filled,bold", fillcolor="#cfe1f5", color="#2b2d42", label="Scripts / hotkeys / Task Scheduler\nactor"];
    "actor.injected" [shape=ellipse, style="filled,bold", fillcolor="#cfe1f5", color="#2b2d42", label="Injected input (SendInput, remote control)\nactor"];
  }

  subgraph cluster_scope {
    label="System boundary\nDesktopIconToggle.exe, run in one of two roles";
    style=rounded; color=#adb5bd; fontsize=11; margin=14;
