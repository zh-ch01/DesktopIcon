  "proc.server" -> "container.exe" [color="#33415c", penwidth=1.0, label="e-server-holds-components\nruns-as | in-process\nProgram.cs:62  Program.cs:99", labeltooltip="Server role is the long-lived process: mutex, message loop, hook, tray.", arrowsize=0.75, constraint=true];
