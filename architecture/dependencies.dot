  "comp.native" -> "ext.kernel32" [color="#33415c", penwidth=1.0, label="e.native-kernel32\ndepends-on | P/Invoke\nNative.cs:379", labeltooltip="12 declarations.", arrowsize=0.75, constraint=true];
  "comp.native" -> "ext.advapi32" [color="#33415c", penwidth=1.0, label="e.native-advapi32\ndepends-on | P/Invoke\nNative.cs:437", labeltooltip="6 declarations.", arrowsize=0.75, constraint=true];
  "comp.desktop" -> "ext.explorer.desktop" [color="#d62828", penwidth=2.6, label="e.desktop-showhide\nwrites | ShowWindowAsync on foreign HWND\nDesktop.cs:91  Desktop.cs:96", labeltooltip="The actual toggle primitive, deliberately async so a hung explorer cannot stall the hook thread.", arrowsize=0.75, constraint=true];
  "comp.remoteblock" -> "ext.explorer.desktop" [color="#d62828", penwidth=2.2, label="e.desktop-hittest\ncalls | SendMessageTimeoutW LVM_SUBITEMHITTEST, 150 ms\nDesktop.cs:165", labeltooltip="Asks explorer's list view whether the point is on an item.", arrowsize=0.75, constraint=true];
  "comp.desktop" -> "ext.explorer.desktop" [color="#33415c", penwidth=1.0, label="e.desktop-readstate\nreads | IsWindowVisible\nDesktop.cs:70", labeltooltip="State is never cached; re-queried every call.", arrowsize=0.75, constraint=true];
  "comp.trayicon" -> "ext.explorer.tray" [color="#33415c", penwidth=1.0, label="e.tray-explorer\nregisters-with | Shell_NotifyIconW\nTrayIcon.cs:39  TrayIcon.cs:46", labeltooltip="NIM_ADD, NIM_SETVERSION v4, NIM_DELETE.", arrowsize=0.75, constraint=true];
  "ext.explorer.tray" -> "comp.program" [color="#3a5a40", penwidth=2.0, style=dashed, label="e.taskbarcreated\npublishes | RegisterWindowMessageW broadcast\nProgram.cs:199  Native.cs:42", labeltooltip="Shell restart invalidates the registration; the handler re-arms with a bounded retry.", arrowsize=0.75, constraint=true];
  "comp.settings" -> "store.hkcu.settings" [color="#33415c", penwidth=1.0, label="e.settings-store\nreads-writes | registry\nSettings.cs:12", labeltooltip="REG_DWORD only; deleting the key restores defaults.", arrowsize=0.75, constraint=true];
  "comp.settings" -> "store.hkcu.settings" [color="#33415c", penwidth=1.0, label="e-desktop-writes-state\nreads-writes | registry\nSettings.cs:33", labeltooltip="Last icon visibility is persisted here by Desktop, not by Program.", arrowsize=0.75, constraint=true];
  "comp.autostart" -> "store.hkcu.run" [color="#33415c", penwidth=1.0, label="e.autostart-store\nreads-writes | registry\nAutostart.cs:52  Autostart.cs:99", labeltooltip="One REG_SZ; self-heal only rewrites a path whose file is gone.", arrowsize=0.75, constraint=true];
  "proc.cli" -> "proc.server" [color="#9d0208", penwidth=2.2, style=dashed, label="e.cli-server-discover\ncalls | FindWindowExW by class+title, SendMessageTimeoutW 1000 ms / PostMessageW\nIpcWindow.cs:77  IpcWindow.cs:97  IpcWindow.cs:109\nProgram.cs:635", labeltooltip="Discovery verifies the owning exe path, so a decoy window with the same title is not trusted. Queries are synchronous with a timeout; --exit is fire-and-forget.", arrowsize=0.75, constraint=true];
  "proc.cli" -> "comp.desktop" [color="#33415c", penwidth=1.0, label="e.cli-direct-desktop\ncalls | in-process call\nProgram.cs:529  Program.cs:537  README.md:35", labeltooltip="--toggle/--show/--hide do not need the background instance; README states this on purpose so the CLI is always an escape hatch.", arrowsize=0.75, constraint=true];
  "comp.program" -> "comp.program" [color="#588157", penwidth=1.8, label="e.bootrestore-timer\nself-loop | WM_TIMER id 0xB007, 2000 ms, max 10 retries, always killed\nProgram.cs:115  Program.cs:149  Program.cs:146", labeltooltip="Boot restore retries until explorer builds the icon layer, then kills the timer.", arrowsize=0.75, constraint=false];
  "comp.native" -> "comp.program" [color="#33415c", penwidth=1.0, label="e.wmapp-protocol\nsupplies | constant declarations\nNative.cs:21  Native.cs:24  Native.cs:27\nNative.cs:30  Native.cs:33  Native.cs:35\nNative.cs:36", labeltooltip="The WM_APP protocol the two roles speak: ping, gesture hand-off, icon-test return, two stat channels, quit. Values are fixed, not runtime-allocated, except TaskbarCreated which is dynamic by design.", arrowsize=0.75, constraint=true];
  "comp.program" -> "comp.program" [color="#588157", penwidth=1.8, label="e.gesture-throttle\nself-loop | in-process guard\nProgram.cs:312  Program.cs:350", labeltooltip="100 ms floor on the decision path. Not politeness: a queued backlog pushes the hook past LowLevelHooksTimeout (300 ms), which makes the whole system's mouse stutter and silently removes the hook while hook_set still reports 1.", arrowsize=0.75, constraint=false];
  "comp.program" -> "comp.program" [color="#588157", penwidth=1.8, label="e.gesture-inflight\nself-loop | Interlocked\nProgram.cs:332", labeltooltip="Exactly one hit test may be outstanding. The only concurrency primitive in the app, and drops are counted rather than silently swallowed.", arrowsize=0.75, constraint=false];
  "comp.program" -> "comp.desktop" [color="#33415c", penwidth=1.0, label="e.gesture-worker\ncalls | ThreadPool work item, result posted back as WM_APP_ICON_TEST\nProgram.cs:341  Program.cs:346  Program.cs:325", labeltooltip="Deliberate offload: the message thread does cheap checks only (point classification, style bit); anything that sends to explorer moves off it.", arrowsize=0.75, constraint=true];
  "comp.desktop" -> "ext.explorer.desktop" [color="#33415c", penwidth=1.0, label="e.desktop-point\nreads | WindowFromPoint / GetAncestor / GetParent / style bit\nDesktop.cs:119  Desktop.cs:128  Desktop.cs:138", labeltooltip="Decides whether a screen point is the desktop itself, and returns the icon list under it. Read from the message thread, so no cross-process send here.", arrowsize=0.75, constraint=true];
  "comp.desktop" -> "ext.explorer.desktop" [color="#d62828", penwidth=2.6, label="e.desktop-hittest-detail\ncalls | LVM_SUBITEMHITTEST via SendMessageTimeoutW, 150 ms, abort-if-hung\nDesktop.cs:149  Desktop.cs:152  Desktop.cs:154\nDesktop.cs:165", labeltooltip="Asks explorer's list view for the item at a client point. Client coordinates are converted first; the pid check exists because a DefView can belong to a different process than expected.", arrowsize=0.75, constraint=true];
  "comp.gesturehook" -> "ext.user32" [color="#33415c", penwidth=1.0, label="e.hook-chains\ncalls | CallNextHookEx\nDesktopGestureHook.cs:99  DesktopGestureHook.cs:46", labeltooltip="Every event is chained on. The gesture never consumes the click, so double-clicking an icon still launches the program normally.", arrowsize=0.75, constraint=true];
  "comp.program" -> "comp.gesturehook" [color="#33415c", penwidth=1.0, label="e.hook-uninstall\ndepends-on | in-process call\nProgram.cs:107  DesktopGestureHook.cs:105", labeltooltip="Loop exit disposes hook, window, tray in that order; a leaked global hook would outlive the intent.", arrowsize=0.75, constraint=true];
  "comp.program" -> "comp.desktop" [color="#588157", penwidth=1.8, label="e.endsession-persist\nwrites | in-process call at WM_QUERYENDSESSION\nProgram.cs:234", labeltooltip="Re-reads the REAL visibility at session end and stores it, so a change made through explorer's own right-click menu is not lost at reboot.", arrowsize=0.75, constraint=true];
  "comp.program" -> "ext.user32" [color="#33415c", penwidth=1.0, label="e.menu-blocks\ncalls | TrackPopupMenuEx (blocking)\nProgram.cs:474", labeltooltip="Menu tracking blocks the message thread by design; this is also why WM_CLOSE is ignored - the system sends it to the menu owner while tracking.", arrowsize=0.75, constraint=true];
  "proc.cli" -> "proc.server" [color="#9d0208", penwidth=2.0, style=dashed, label="e.status-diag\nreads | three read-only WM_APP stat channels\nProgram.cs:545  Program.cs:559  Program.cs:568\nProgram.cs:398  Program.cs:407  Program.cs:444", labeltooltip="Graded self-report instead of one health boolean: hook installed vs callback actually fired vs a double click was paired vs ShowWindow actually ran vs dropped. Two outages this session were 'looks fine, does nothing' and only the graded counters localised them.", arrowsize=0.75, constraint=true];
  "comp.ipcwindow" -> "ext.kernel32" [color="#33415c", penwidth=1.0, label="e.ipc-identity\ncalls | OpenProcess + QueryFullProcessImageNameW\nIpcWindow.cs:15  IpcWindow.cs:52  IpcWindow.cs:91", labeltooltip="Instance discovery matches class AND title, then confirms the owning exe path. Title alone would let any foreign window receive --exit.", arrowsize=0.75, constraint=true];
  "comp.settings" -> "ext.advapi32" [color="#33415c", penwidth=1.0, label="e.settings-create\nwrites | RegCreateKeyExW / RegSetValueExW\nSettings.cs:55", labeltooltip="Create-on-write, no installer step; deleting the key is the documented way back to defaults.", arrowsize=0.75, constraint=true];
  "comp.trayicon" -> "ext.shell32" [color="#33415c", penwidth=1.0, label="e.tray-teardown\nwrites | NIM_DELETE + DestroyIcon\nTrayIcon.cs:76  TrayIcon.cs:79", labeltooltip="Registration is removed on dispose; icon handles extracted for use are destroyed. Both matter - a leaked registration leaves a dead ghost icon in the shell.", arrowsize=0.75, constraint=true];
}
