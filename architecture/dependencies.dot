    "comp.trayicon" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="TrayIcon\nmodule"];
    "comp.desktop" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="Desktop\nmodule"];
    "comp.remoteblock" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="RemoteBlock\nmodule"];
    "comp.settings" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="Settings\nmodule"];
    "comp.autostart" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="Autostart\nmodule"];
    "comp.native" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="Native\nmodule"];
  }

  subgraph cluster_os {
    label="Win32 subsystem\nreached only through the Native declaration surface";
    style=rounded; color=#adb5bd; fontsize=11; margin=14;
    "ext.user32" [shape=hexagon, style=filled, fillcolor="#ccd5ae", color="#3a5a40", label="user32.dll\nexternal-system"];
    "ext.shell32" [shape=hexagon, style=filled, fillcolor="#ccd5ae", color="#3a5a40", label="shell32.dll\nexternal-system"];
    "ext.kernel32" [shape=hexagon, style=filled, fillcolor="#ccd5ae", color="#3a5a40", label="kernel32.dll\nexternal-system"];
    "ext.advapi32" [shape=hexagon, style=filled, fillcolor="#ccd5ae", color="#3a5a40", label="advapi32.dll\nexternal-system"];
  }

  subgraph cluster_shell {
    label="Explorer (foreign process)\nthe app reaches into these windows";
    style=rounded; color=#adb5bd; fontsize=11; margin=14;
    "ext.explorer.desktop" [shape=hexagon, style=filled, fillcolor="#ccd5ae", color="#3a5a40", label="Explorer desktop window tree\nexternal-system"];
    "ext.explorer.tray" [shape=hexagon, style=filled, fillcolor="#ccd5ae", color="#3a5a40", label="Explorer notification area\nexternal-system"];
  }

  subgraph cluster_store {
    label="HKCU registry\nthe only persistence the app owns";
    style=rounded; color=#adb5bd; fontsize=11; margin=14;
    "store.hkcu.settings" [shape=cylinder, style=filled, fillcolor="#eab676", color="#9d0208", label="HKCU\Software\DesktopIconToggle\ndatabase"];
    "store.hkcu.run" [shape=cylinder, style=filled, fillcolor="#eab676", color="#9d0208", label="HKCU\...\CurrentVersion\Run\ndatabase"];
  }

