  "comp.program" -> "comp.gesturehook" [color="#33415c", penwidth=1.0, label="e.program-hook\ndepends-on | in-process call\nProgram.cs:87", labeltooltip="Installs the hook and reads its diagnostic counters.", arrowsize=0.75, constraint=true];
