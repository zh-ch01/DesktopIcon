  node [fontname="Segoe UI", fontsize=9];
  edge [fontname="Consolas", fontsize=7, labeldistance=1.6, fontsize=7];

  subgraph cluster_actors {
    label="Actors\npeople and things outside the system that drive it";
    style=rounded; color=#adb5bd; fontsize=11; margin=14;
