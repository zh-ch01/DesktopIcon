    "container.exe" [shape=box, style="rounded,filled,dashed", fillcolor="#fff3d6", color="#7f5539", label="DesktopIconToggle.exe\ncontainer"];
    "proc.server" [shape=box, style="rounded,filled,dashed", fillcolor="#fff3d6", color="#7f5539", label="Background instance (server role)\ncontainer"];
    "proc.cli" [shape=box, style="rounded,filled,dashed", fillcolor="#fff3d6", color="#7f5539", label="One-shot CLI invocation (client role)\ncontainer"];
  }

  subgraph cluster_app {
    label="In-process components\nthe eight source files of the one assembly";
    style=rounded; color=#adb5bd; fontsize=11; margin=14;
    "comp.program" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="Program\nmodule"];
    "comp.ipcwindow" [shape=component, style=filled, fillcolor="#ffffff", color="#33415c", label="IpcWindow\nmodule"];
